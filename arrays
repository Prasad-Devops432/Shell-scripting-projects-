#!/bin/bash
#
# List the VPC IDs in each of a set of AWS regions.
#
# Requirements: AWS CLI configured with credentials that can call ec2:DescribeVpcs
# Usage:  ./arrays

set -u

REGIONS=(us-east-1 ap-south-1 us-east-2)

for REGION in "${REGIONS[@]}"; do
    echo "Getting VPCs for region $REGION......"

    # --output text returns the IDs separated by whitespace
    if ! VPC_LIST="$(aws ec2 describe-vpcs --region "$REGION" --query 'Vpcs[].VpcId' --output text 2>/dev/null)"; then
        echo "Could not list VPCs in region $REGION (check the region name and your credentials)"
        continue
    fi

    if [ -z "$VPC_LIST" ]; then
        echo "No VPCs found in $REGION"
        continue
    fi

    for VPC in $VPC_LIST; do
        echo "VPC ID is: $VPC"
    done
done
